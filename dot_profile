# ~/.profile — managed by chezmoi
# Environment configuration for login shells.

# User executables
# User executables — avoid duplicate PATH entries
for dir in "$HOME/bin" "$HOME/.local/bin"; do
    if [ -d "$dir" ]; then
        case ":$PATH:" in
            *":$dir:"*) ;;
            *) PATH="$dir:$PATH" ;;
        esac
    fi
done

export PATH
# Rust
if [ -f "$HOME/.cargo/env" ]; then
    . "$HOME/.cargo/env"
fi
